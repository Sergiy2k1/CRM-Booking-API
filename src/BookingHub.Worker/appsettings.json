{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=bookinghub;Username=bookinghub;Password=bookinghub;GSS Encryption Mode=Disable"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "bookinghub.events",
    "NotificationQueue": "bookinghub.notifications",
    "NotificationBindingKey": "booking.#",
    "ReconnectSeconds": 5
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "MaxAttempts": 10
  }
}
